# Values are read by Gradle at build time, not at app runtime.
# Copy to .env and load it in your shell before ./gradlew, or set the same
# names as repository variables/secrets in GitHub Actions.

API_BASE_URL=https://api.example.com
API_UPLOAD_PATH=/api/upload
API_ACCESS_CODE=replace-with-the-real-access-code
API_ACCESS_HEADER=x-access-code

# Phone numbers are sent as +<country_code><number>.
DEFAULT_COUNTRY_CODE=+228

# auto | voice_call | voice_communication | voice_recognition | mic | default
RECORDING_AUDIO_SOURCE=auto
RECORDING_BITRATE=32000

# Never enable this in production.
ALLOW_CLEARTEXT=false
